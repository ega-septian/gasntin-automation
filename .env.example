# Backend API under test
API_BASE_URL=http://localhost:8081

# Frontend under test (used once the WEB suite is added)
WEB_BASE_URL=http://localhost:5173

# Required for the API suite. Used to verify the stored password is a bcrypt
# hash — the API never exposes password_hash, so this is the only way to check
# it. Global setup fails fast with a clear error if this is missing or unreachable.
DATABASE_URL=postgres://teststore:teststore@localhost:5432/teststore?sslmode=disable

# Optional. Set this to sync test results to Qase (project GASNTIN) after each
# run. Leave empty to run fully local — no Qase upload attempted.
QASE_API_TOKEN=

# Used by the /generate-testcase and /automate-testcase skills to call the
# Qase REST API directly (creating/patching test cases).
QASE_PROJECT_CODE=GASNTIN
